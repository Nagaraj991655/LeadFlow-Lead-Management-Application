pipeline {
    agent any

    stages {

        stage('Cleanup') {
            steps {
                sh '''
                docker compose down || true
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                docker compose build
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                docker compose up -d
                '''
            }
        }

    }
}
