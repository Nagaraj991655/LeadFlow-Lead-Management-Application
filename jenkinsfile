pipeline {
    agent any

    stages {

        stage('Cleanup') {
            steps {
                sh '''
                docker compose -p leadflow down --remove-orphans || true
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                docker compose -p leadflow build
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                docker compose -p leadflow up -d
                '''
            }
        }
    }
}
